{
  "name": "@simsustech/quasar-components-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "run-s build:preset build:components",
    "build:preset": "cd packages/preset && pnpm run build",
    "build:components": "cd packages/components && pnpm run build",
    "format:check:preset": "cd packages/preset && pnpm run format:check",
    "format:check:components": "cd packages/components && pnpm run format:check",
    "format:write:preset": "cd packages/preset && pnpm run format:write",
    "format:write:components": "cd packages/components && pnpm run format:write",
    "format:check": "run-s format:check:preset format:check:components",
    "format:write": "run-s format:write:preset format:write:components",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "changeset publish",
    "lint": "run-s lint:preset lint:components",
    "lint:preset": "cd packages/preset && pnpm run lint",
    "lint:components": "cd packages/components && pnpm run lint",
    "test": "run-s test:components",
    "test:components": "cd packages/components && pnpm run test",
    "test:e2e": "playwright test",
    "knip": "knip"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "knip": "^6.45.1",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint && pnpm run format:check",
    "commit-msg": "pnpm exec commitlint --edit $1"
  }
}
